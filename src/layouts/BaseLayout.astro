---
import '@/styles/global.css';
import { execSync } from 'node:child_process';

function getLastCommit() {
  try {
    const hash = execSync('git rev-parse --short=7 HEAD', { encoding: 'utf8' }).trim();
    const date = execSync('git log -1 --format=%as', { encoding: 'utf8' }).trim();
    return { hash, date };
  } catch {
    return null;
  }
}

const lastCommit = getLastCommit();

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  section?: 'home' | 'blog' | 'projects' | 'post' | 'resume' | '404';
}
const { title, description, ogImage, ogType, section = 'home' } = Astro.props;

const siteUrl = "https://aunchers.github.io";
const defaultDesc = "thoughts, tutorials, logs, and other writings.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || defaultDesc} />
    <script is:inline>
      var savedTheme = localStorage.getItem("theme");
      if (savedTheme) {
        document.documentElement.setAttribute("data-theme", savedTheme);
      }
    </script>
    <link
      rel="icon"
      id="favicon"
      type="image/svg+xml"
      href="/batlogo.svg"
    />
    <link
      rel="preload"
      href="/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fira-code-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType || "website"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={description || defaultDesc} />
    <meta property="og:site_name" content="aunchers" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">aunchers<span class="brand-dot">.</span></a>
        <nav class="nav" aria-label="main">
          <a href="/blog" aria-current={section === "blog" ? "page" : undefined}>blog</a>
          <a
            href="/projects"
            aria-current={section === "projects" ? "page" : undefined}
          >projects</a>
          <span class="nav-locked" aria-disabled="true">resume</span>
          <!-- <a href="/resume" aria-current={section === "resume" ? "page" : undefined}>resume</a> -->
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="switch theme"
            title="switch theme"
          >
            <svg
              class="theme-icon"
              data-icon="bat"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M17 16c.74 -2.286 2.778 -3.762 5 -3c-.173 -2.595 .13 -5.314 -2 -7.5c-1.708 2.648 -3.358 2.557 -5 2.5v-4l-3 2l-3 -2v4c-1.642 .057 -3.292 .148 -5 -2.5c-2.13 2.186 -1.827 4.905 -2 7.5c2.222 -.762 4.26 .714 5 3c2.593 0 3.889 .952 5 4c1.111 -3.048 2.407 -4 5 -4z"
              ></path>
              <path d="M9 8a3 3 0 0 0 6 0"></path>
            </svg>
            <svg
              class="theme-icon"
              data-icon="midnight"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"
              ></path>
            </svg>
            <svg
              class="theme-icon"
              data-icon="paper"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
              <path
                d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"
              ></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-col">
          <p>made with love by aunchers</p>
          {
            lastCommit && (
              <p class="footer-commit">
                commit{" "}
                <a
                  href={`https://github.com/aunchers/aunchers.github.io/commit/${lastCommit.hash}`}
                >
                  {lastCommit.hash}
                </a>{" "}
                · {lastCommit.date}
              </p>
            )
          }
        </div>
        <p class="footer-meta">
          <slot name="footer-meta" />
          <a href="/rss.xml">rss</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      var THEME_ORDER = ["bat", "midnight", "paper"];
      function currentTheme() {
        return document.documentElement.getAttribute("data-theme") || "bat";
      }
      function updateThemeAssets() {
        var theme = currentTheme();
        var favicon = document.getElementById("favicon");
        if (favicon) {
          favicon.href = "/" + theme + "logo.svg";
        }
      }

      updateThemeAssets();
      new MutationObserver(updateThemeAssets).observe(
        document.documentElement,
        { attributes: true },
      );

      var themeBtn = document.getElementById("theme-toggle");
      if (themeBtn) {
        themeBtn.addEventListener("click", function (e) {
          e.preventDefault();
          var next =
            THEME_ORDER[
              (THEME_ORDER.indexOf(currentTheme()) + 1) % THEME_ORDER.length
            ];
          if (next === "bat") {
            document.documentElement.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          } else {
            document.documentElement.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
          }
          updateThemeAssets();
        });
      }
    </script>
    <script>
      import "astro:prefetch";
    </script>
  </body>
</html>
