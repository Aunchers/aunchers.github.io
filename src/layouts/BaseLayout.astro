---
import '@/styles/global.css';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  section?: 'home' | 'blog' | 'projects' | 'post' | 'resume' | '404';
}
const { title, description, ogImage, ogType } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const destinations = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
];

const siteUrl = "https://aunchers.github.io";
const defaultDesc = "thoughts, tutorials, logs, and other writings.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description || defaultDesc} />
    <script is:inline>
      var savedTheme = localStorage.getItem("theme");
      if (savedTheme) {
        document.documentElement.setAttribute("data-theme", savedTheme);
      }
    </script>
    <link
      rel="icon"
      id="favicon"
      type="image/svg+xml"
      href="/batlogo.svg"
    />
    <link
      rel="preload"
      href="/fonts/dm-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fira-code-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType || "website"} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={description || defaultDesc} />
    <meta property="og:site_name" content="aunchers" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl)} />}
  </head>
  <body>
    <a class="skip" href="#main">skip to content</a>

    <main id="main">
      <div class:list={['wrap', { 'interior-wrap': !isHome }]}>
        <div class="site-card">
          <div class="site-card-bar">
            <nav class="site-destinations" aria-label="Main navigation">
              {destinations.map(link => (
                <a href={link.href} aria-current={path === link.href ? 'page' :
                  link.href !== '/' && path.startsWith(link.href + '/') ? 'location' : undefined}>
                  {link.label}
                </a>
              ))}
            </nav>
            <ThemeToggle />
          </div>
          <slot />
        </div>
      </div>
    </main>

    <script is:inline>
      var THEME_ORDER = ["bat", "midnight", "paper"];
      function currentTheme() {
        return document.documentElement.getAttribute("data-theme") || "bat";
      }
      function updateThemeAssets() {
        var theme = currentTheme();
        var favicon = document.getElementById("favicon");
        if (favicon) {
          favicon.href = "/" + theme + "logo.svg";
        }
      }

      updateThemeAssets();
      new MutationObserver(updateThemeAssets).observe(
        document.documentElement,
        { attributes: true },
      );

      var themeBtn = document.getElementById("theme-toggle");
      if (themeBtn) {
        themeBtn.addEventListener("click", function (e) {
          e.preventDefault();
          var next =
            THEME_ORDER[
              (THEME_ORDER.indexOf(currentTheme()) + 1) % THEME_ORDER.length
            ];
          if (next === "bat") {
            document.documentElement.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          } else {
            document.documentElement.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
          }
          updateThemeAssets();
        });
      }
    </script>
    {
      // no service worker in dev, so hot reload never fights a stale cache
      import.meta.env.PROD && (
        <script is:inline>
          if ("serviceWorker" in navigator) {
            window.addEventListener("load", function () {
              navigator.serviceWorker.register("/sw.js").catch(function () {});
            });
          }
        </script>
      )
    }
    <script>
      import "astro:prefetch";
    </script>
  </body>
</html>
