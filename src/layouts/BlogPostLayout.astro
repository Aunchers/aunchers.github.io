---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Callout from '@/components/Callout.astro';
import Toc from '@/components/Toc.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    updatedDate?: Date;
    slug?: string;
    status?: string;
    externalUrl?: string;
    cover?: string;
    coverAlt?: string;
  };
  lastCommit?: { hash: string; date: string } | null;
  headings?: { depth: number; slug: string; text: string }[];
  series?: { slug: string; name: string; part: number; total: number } | null;
}

const { frontmatter, lastCommit, headings, series } = Astro.props;

const publishedISO = frontmatter.date.toISOString().slice(0, 10);
// commit history for this post
const historyUrl = frontmatter.slug
  ? `https://github.com/Aunchers/aunchers.github.io/commits/main/src/content/posts/${frontmatter.slug}.mdx`
  : null;

const updatedISO = lastCommit ? lastCommit.date : publishedISO;
---

<BaseLayout
  title={`${frontmatter.title} - aunchers`}
  description={frontmatter.description}
  ogType="article"
  section="post"
>
  {
    frontmatter.status === "archived" && (
      <Callout type="warning" title="archived">
        This post is older and may contain outdated information.
      </Callout>
    )
  }

  {
    frontmatter.status === "wip" && (
      <div class="wip-line">
        <span>work in progress</span>
      </div>
    )
  }

  <header class="post-hero">
    <h1 class="post-hero-title">{frontmatter.title}</h1>
    <p class="post-subtitle">{frontmatter.description}</p>
    <div class="meta-row">
      <span>
        <span class="meta-key">published</span>
        <time datetime={publishedISO}>{publishedISO}</time>
      </span>
      <span class="meta-sep">·</span>
      <span>
        <span class="meta-key">updated</span>
        {
          historyUrl ? (
            <a href={historyUrl} target="_blank" rel="noopener" title="edit history">
              {updatedISO}
            </a>
          ) : (
            updatedISO
          )
        }
      </span>
    </div>
  </header>

  {
    frontmatter.cover && (
      <figure class="cover-image">
        <img
          src={frontmatter.cover}
          alt={frontmatter.coverAlt || frontmatter.title}
        />
        {frontmatter.coverAlt && <figcaption>{frontmatter.coverAlt}</figcaption>}
      </figure>
    )
  }

  <div class="post-shell">
    {headings && <Toc headings={headings} />}

    <article class="post-content">
      {
        series && (
          <p class="series-note">
            this is part {series.part} of {series.total} in my{" "}
            <a href={`/blog/series/${series.slug}`}>{series.name} series →</a>
          </p>
        )
      }
      <slot />
    </article>
  </div>

  <nav class="post-nav">
    <a href="/blog">← all posts</a>
  </nav>
</BaseLayout>
