---
import '../styles/global.css';
import Callout from '../components/Callout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    status?: string;
    externalUrl?: string;
    cover?: string;
    coverAlt?: string;
  };
}

const { frontmatter } = Astro.props;

const fmtDate = (d: Date) => {
  const mo = String(d.getMonth() + 1).padStart(2, "0");
  const dy = String(d.getDate()).padStart(2, "0");
  const yr = d.getFullYear();
  return `${mo}.${dy}.${yr}`;
};
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title}</title>
  <script is:inline>
    var savedTheme = localStorage.getItem('theme');
    if (savedTheme) { document.documentElement.setAttribute('data-theme', savedTheme); }
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/fira-code-latin.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:title" content={frontmatter.title} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:description" content={frontmatter.description} />
  <meta property="og:site_name" content="CHAIRS" />
</head>
<body>
  <div class="page">
    <nav class="sub-nav">
      <a href="/">home</a>
      <span class="sub-nav-sep">/</span>
      <a href="/blog">blog</a>
    </nav>
    <hr>

    {frontmatter.status === "archived" && (
      <Callout type="warning" title="archived">
        This post is older and may contain outdated information.
      </Callout>
    )}

    {frontmatter.status === "wip" && (
      <div class="wip-line">
        <span class="muted-label">work in progress</span>
      </div>
    )}

    <h1 class="post-hero-title">{frontmatter.title}</h1>

    <div class="post-meta-top">
      <span class="meta-date">{fmtDate(frontmatter.date)}</span>
    </div>

    <p class="post-subtitle">{frontmatter.description}</p>

    {frontmatter.cover && (
      <figure class="cover-image">
        <img src={frontmatter.cover} alt={frontmatter.coverAlt || frontmatter.title} />
        {frontmatter.coverAlt && <figcaption>{frontmatter.coverAlt}</figcaption>}
      </figure>
    )}

    <article class="post-content">
      <slot />
    </article>
    <hr>

    <div class="post-nav">
      <a href="/blog">all posts</a>
    </div>
    <div class="theme-switcher" style="position: fixed; bottom: 1rem; right: 1rem; font-size: 10px; color: var(--muted); font-style: normal; opacity: 0.5;">
      [<a href="#" class="theme-opt" data-theme="default">default</a>][<a href="#" class="theme-opt" data-theme="midnight">midnight</a>][<a href="#" class="theme-opt" data-theme="paper">paper</a>]
    </div>
  </div>

  <script is:inline>
    function updateThemeAssets() {
      const theme = document.documentElement.getAttribute('data-theme') || 'default';
      const badge = document.getElementById('home-badge');
      if (badge) { badge.src = `/${theme}8831.png`; }
    }
    updateThemeAssets();
    new MutationObserver(updateThemeAssets)
      .observe(document.documentElement, { attributes: true });

    document.querySelectorAll('.theme-opt').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var theme = this.getAttribute('data-theme');
        if (theme === 'default') {
          document.documentElement.removeAttribute('data-theme');
          localStorage.removeItem('theme');
        } else {
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('theme', theme);
        }
      });
    });
  </script>
</body>
</html>
