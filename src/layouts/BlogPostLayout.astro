---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Callout from '@/components/Callout.astro';
import Toc from '@/components/Toc.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: Date;
    slug?: string;
    status?: string;
    externalUrl?: string;
    cover?: string;
    coverAlt?: string;
  };
  lastCommit?: { hash: string; date: string } | null;
  headings?: { depth: number; slug: string; text: string }[];
  series?: {
    slug: string;
    name: string;
    chapter: string | null;
    chapterSlug: string | null;
    topic: string | null;
    topicSlug: string | null;
    part: number;
    total: number;
  } | null;
}

const { frontmatter, lastCommit, headings, series } = Astro.props;

const publishedISO = frontmatter.date.toISOString().slice(0, 10);
// commit history for this post
const historyUrl = frontmatter.slug
  ? `https://github.com/Aunchers/aunchers.github.io/commits/main/src/content/posts/${frontmatter.slug}.mdx`
  : null;

const updatedISO = lastCommit ? lastCommit.date : publishedISO;
// repo path, used by the client-side "last updated" lookup
const postPath = frontmatter.slug
  ? `src/content/posts/${frontmatter.slug}.mdx`
  : null;
---

<BaseLayout
  title={`${frontmatter.title} - aunchers`}
  description={frontmatter.description}
  ogType="article"
  section="post"
>
  {
    frontmatter.status === "archived" && (
      <Callout type="warning" title="archived">
        This post is older and may contain outdated information.
      </Callout>
    )
  }

  {
    frontmatter.status === "wip" && (
      <div class="wip-line">
        <span>work in progress</span>
      </div>
    )
  }

  <header class="post-hero">
    <h1 class="post-hero-title">{frontmatter.title}</h1>
    <p class="post-subtitle">{frontmatter.description}</p>
    <div class="meta-row">
      <span>
        <span class="meta-key">published</span>
        <time datetime={publishedISO}>{publishedISO}</time>
      </span>
      {
        lastCommit && (
          <>
            <span class="meta-sep">·</span>
            <span>
              <span class="meta-key">last updated</span>
              {historyUrl ? (
                <a
                  href={historyUrl}
                  target="_blank"
                  rel="noopener"
                  title="edit history"
                >
                  <time
                    id="last-updated"
                    datetime={updatedISO}
                    data-post={postPath}
                  >
                    {updatedISO}
                  </time>
                </a>
              ) : (
                <time
                  id="last-updated"
                  datetime={updatedISO}
                  data-post={postPath}
                >
                  {updatedISO}
                </time>
              )}
            </span>
          </>
        )
      }
    </div>
  </header>

  {
    frontmatter.cover && (
      <figure class="cover-image">
        <img
          src={frontmatter.cover}
          alt={frontmatter.coverAlt || frontmatter.title}
        />
        {frontmatter.coverAlt && (
          <figcaption>{frontmatter.coverAlt}</figcaption>
        )}
      </figure>
    )
  }

  <div class="post-shell">
    {headings && <Toc headings={headings} />}

    <article class="post-content">
      {
        series && (
          <p class="series-note">
            this is part {series.part} of {series.total}
            {series.topic && series.topicSlug ? (
              <>
                {" in "}
                <a
                  href={`/blog/series/${series.slug}/${series.chapterSlug}/${series.topicSlug}`}
                >
                  {series.topic}
                </a>
                {series.chapter && series.chapterSlug ? (
                  <>
                    {", part of the "}
                    <a
                      href={`/blog/series/${series.slug}/${series.chapterSlug}`}
                    >
                      {series.chapter}
                    </a>{" chapter"}
                  </>
                ) : null}
              </>
            ) : series.chapter && series.chapterSlug ? (
              <>
                {" of the "}
                <a href={`/blog/series/${series.slug}/${series.chapterSlug}`}>
                  {series.chapter}
                </a>{" chapter"}
              </>
            ) : null}{" "}
            in my{" "}
            <a href={`/blog/series/${series.slug}`}>{series.name} series →</a>
          </p>
        )
      }
      <slot />
    </article>
  </div>

  <nav class="post-nav">
    <a href="/blog">← all posts</a>
  </nav>
</BaseLayout>

{
  postPath && (
    <script is:inline>
      // ask github for this file's newest commit, so the date stays right
      // even when the site was built without full git history
      (function () {
        var el = document.getElementById("last-updated");
        if (!el || !window.fetch) return;

        var path = el.getAttribute("data-post");
        if (!path) return;

        function show(iso) {
          el.textContent = iso;
          el.setAttribute("datetime", iso);
        }

        // if this file's newest commit is the one the page was built from,
        // nothing newer exists, so there is nothing to ask github about
        var footerHash = document.getElementById("footer-commit-hash");
        var build = footerHash ? footerHash.textContent.trim() : "";
        var key = "updated:" + path;

        try {
          var cached = JSON.parse(localStorage.getItem(key) || "null");
          if (cached) {
            if (cached.sha && build && cached.sha.slice(0, 7) === build) {
              show(cached.date);
              return;
            }
            if (Date.now() - cached.at < 86400000) {
              show(cached.date);
              return;
            }
          }
        } catch (e) {}

        if (!navigator.onLine) return;

        var url =
          "https://api.github.com/repos/Aunchers/aunchers.github.io/commits?path=" +
          encodeURIComponent(path) +
          "&per_page=1";

        fetch(url, { headers: { Accept: "application/vnd.github+json" } })
          .then(function (res) {
            return res.ok ? res.json() : null;
          })
          .then(function (data) {
            if (!data || !data[0] || !data[0].commit) return;
            var iso = data[0].commit.committer.date.slice(0, 10);
            show(iso);
            try {
              localStorage.setItem(
                key,
                JSON.stringify({ date: iso, sha: data[0].sha, at: Date.now() }),
              );
            } catch (e) {}
          })
          .catch(function () {});
      })();
    </script>
  )
}
