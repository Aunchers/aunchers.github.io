---
interface Props {
  items: { date: string; text: string }[];
}

const { items } = Astro.props;
---

<div class="timeline">
  {
    items.map((item) => (
      <div class="timeline-item">
        <strong class="timeline-date">{item.date}</strong>
        <span class="timeline-text">{item.text}</span>
      </div>
    ))
  }
</div>
