---
interface Props {
  items: { date: string; text: string }[];
}

const { items } = Astro.props;
---

<div class="timeline">
  <ol class="timeline-list">
    {
      items.map((item) => (
        <li class="timeline-item">
          <span class="timeline-date">{item.date}</span>
          <span class="timeline-text">{item.text}</span>
        </li>
      ))
    }
  </ol>
</div>
