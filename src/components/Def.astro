---
import { lookupTerm } from '@/lib/glossary';

interface Props {
  term: string;
  definition?: string;
  href?: string;
}

const { term, definition, href } = Astro.props;

const entry = lookupTerm(term);
const text = definition ?? entry?.definition;
const link = href ?? entry?.href;
---

{
  text || link ? (
    <span class="def" tabindex="0">
      {term}
      <span class="def-pop" role="tooltip">
        {text && <span class="def-text">{text}</span>}
        {link && (
          <a class="def-link" href={link} target="_blank" rel="noopener">
            more <span aria-hidden="true">↗</span>
          </a>
        )}
      </span>
    </span>
  ) : (
    <span>{term}</span>
  )
}
