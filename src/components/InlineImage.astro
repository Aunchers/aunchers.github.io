---
interface Props {
  src: string;
  label: string;
  href?: string;
  fit?: 'cover' | 'contain';
}

const { src, label, href, fit = 'cover' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class="mention"
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener" : undefined}
>
  <img
    class="mention-image"
    style={fit === 'contain' ? 'object-fit: contain; border: 0; border-radius: 0;' : undefined}
    src={src}
    alt=""
    width="20"
    height="20"
    loading="lazy"
    decoding="async"
  />
  <span class="mention-name">{label}</span>
</Tag>
