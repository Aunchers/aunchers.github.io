---
interface Props {
  images: { src: string; alt: string; caption?: string; width?: number; height?: string | number }[];
  columns?: number;
}

const { images, columns = 2 } = Astro.props;
---

<div class="gallery" style={`--gallery-columns: ${columns};`}>
  {
    images.map((img) => (
      <figure class="gallery-item">
        <img
          src={img.src}
          alt={img.alt}
          loading="lazy"
          decoding="async"
          width={img.width}
          height={img.height}
          style="width:100%;height:auto;"
        />
        {img.caption && (
          <figcaption class="gallery-caption">{img.caption}</figcaption>
        )}
      </figure>
    ))
  }
</div>
