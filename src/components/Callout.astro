---
interface Props {
  type?: "info" | "warning" | "tip" | "danger" | "note";
  title?: string;
}

const { type = "info", title } = Astro.props;

const labels: Record<string, string> = {
  info: "info",
  warning: "warning",
  tip: "tip",
  danger: "danger",
  note: "note",
};
---

<div class={`callout callout-${type}`}>
  <p class="callout-label">{title || labels[type]}</p>
  <div class="callout-content">
    <slot />
  </div>
</div>
