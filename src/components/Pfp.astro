---
import fs from 'node:fs';
import path from 'node:path';
import pfps from '@/data/pfps.json';

interface Props {
  user: string;
  name: string;
  href?: string;
  src?: string;
}

const { user, name, href, src } = Astro.props;

const people = Object.entries(pfps as Record<string, { href?: string }>);
const person = people.find(([key]) => key.toLowerCase() === user.toLowerCase())?.[1];

const dir = path.join(process.cwd(), 'public', 'pfp');
const files = fs.existsSync(dir) ? fs.readdirSync(dir) : [];
const local = ['webp', 'png', 'jpg', 'gif']
  .map((ext) => `${user.toLowerCase()}.${ext}`)
  .find((file) => files.includes(file));

const image = local ? `/pfp/${local}` : src;
const link = href ?? person?.href;

if (!image) {
  console.warn(`pfp: ${user} has no image, drop a webp in public/pfp or pass src`);
}

const Tag = link ? 'a' : 'span';
const attrs = link ? { href: link, target: '_blank', rel: 'noopener' } : {};
---

<Tag class="mention" {...attrs}>
  {
    image && (
      <img
        class="mention-pfp"
        src={image}
        alt=""
        width="20"
        height="20"
        loading="lazy"
        decoding="async"
      />
    )
  }
  <span class="mention-name">{name}</span>
</Tag>
