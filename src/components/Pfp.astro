---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  user: string;
  name: string;
  href?: string;
}

const { user, name, href } = Astro.props;

const exts = ['png', 'jpg', 'jpeg', 'webp', 'gif'];
const dir = path.join(process.cwd(), 'public', 'pfp');
const ext = exts.find((e) => fs.existsSync(path.join(dir, `${user}.${e}`))) ?? 'png';
---

<a
  class="mention"
  href={href || `https://github.com/${user}`}
  target="_blank"
  rel="noopener"
><img
    class="mention-pfp"
    src={`/pfp/${user}.${ext}`}
    alt=""
    width="20"
    height="20"
    loading="lazy"
    decoding="async"
  /><span class="mention-name">{name}</span></a>
