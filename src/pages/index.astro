---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projectStatusLabels } from '@/project-status';

const done = (await getCollection('projects'))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 3);
---

<BaseLayout
  title="aunchers"
  description="hi. i'm aunchers. i live in canada and i love computers."
  section="home"
>
  <header class="home-hero">
    <a
      class="hero-pfp"
      href="https://github.com/aunchers"
      target="_blank"
      rel="noopener"
      aria-label="aunchers on github"
    >
      <img src="/avatar.png" alt="aunchers" width="64" height="64" />
    </a>

    <div class="hero-text">
      <h1 class="home-name">
        hi. i'm <a href="/blog">aunchers</a>.
      </h1>
      <p class="home-bio">
        I live in <img
          class="flag"
          src="/canada.svg"
          alt="Canada"
          width="20"
          height="10"
        /> and I love computers.
      </p>
    </div>
  </header>

  <div class="card-grid">
    <a class="card" href="/blog">
      <span class="card-title">blog</span>
      <span class="card-desc"
        >thoughts, tutorials, journalism, and other writings.</span
      >
    </a>
    <div
      class="card card-locked"
      aria-disabled="true"
      aria-label="resume, closed for now"
    >
      <span class="card-title">resume</span>
      <span class="card-desc">for applying to stuff.</span>
    </div>
  </div>

  <section class="block">
    <h2 class="block-label">stuff i've done</h2>
    <div class="block-body">
      <ul class="done-list">
        {
          done.map((proj) => (
            <li>
              <a
                class="done-link"
                href={`/projects/${proj.data.name.toLowerCase()}`}
              >
                <span class="done-name">{proj.data.name}</span>
                <span class="done-meta">
                  {proj.data.dateRange ||
                    projectStatusLabels[proj.data.status || "active"]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="block-more"><a href="/projects">more →</a></p>
    </div>
  </section>

  <section class="block">
    <h2 class="block-label">elsewhere</h2>
    <div class="block-body">
      <ul class="links-list">
        <li class="social-item">
          <span class="dead-name">matrix</span><abbr
            class="social-help"
            data-def="fully dead for now, nothing i can do about it"
            tabindex="0">(?)</abbr
          >
          <span class="social-handle dead-handle"
            >#home:matrix.aunchers.org</span
          >
        </li>
        <li class="social-item">
          <button
            class="social-name"
            type="button"
            data-copy="aunchers">discord</button
          ><abbr
            class="social-help"
            data-def="use almost every day. friends or important things only"
            tabindex="0">(?)</abbr
          >
          <span class="social-handle">aunchers</span>
        </li>
        <li class="social-item">
          <button
            class="social-name"
            type="button"
            data-copy="aunchers">fluxer</button
          ><abbr class="social-help" data-def="barely use" tabindex="0"
            >(?)</abbr
          >
          <span class="social-handle">aunchers</span>
        </li>
        <li class="social-item">
          <a
            class="social-name"
            href="https://github.com/aunchers"
            target="_blank"
            rel="noopener">github</a
          ><abbr
            class="social-help"
            data-def="mainly for personal projects"
            tabindex="0">(?)</abbr
          >
          <span class="social-handle">aunchers</span>
        </li>
        <li class="social-item">
          <a class="social-name" href="mailto:1_aunchers@proton.me">email</a
          ><abbr class="social-help" data-def="don't check often." tabindex="0"
            >(?)</abbr
          >
          <span class="social-handle">1_aunchers@proton.me</span>
        </li>
      </ul>

    </div>
  </section>

  <section class="block">
    <h2 class="block-label">badges</h2>
    <div class="block-body">
      <div class="badge-row">
        <a href="https://aunchers.org">
          <img
            src="/badges/aunchers.png"
            alt="aunchers"
            width="88"
            height="31"
          />
        </a>
        <a href="https://astro.build">
          <img
            src="/badges/astro.png"
            alt="built with astro"
            width="88"
            height="31"
          />
        </a>
      </div>
    </div>
  </section>

  <span slot="footer-meta">
    <a href="/aunchers.asc">pgp key</a>
    <a
      href="https://github.com/aunchers/aunchers.github.io/blob/main/LICENSE"
      target="_blank"
      rel="noopener">license</a
    >
    <a
      href="https://github.com/aunchers/aunchers.github.io"
      target="_blank"
      rel="noopener">source</a
    >
  </span>
</BaseLayout>

<script is:inline>
  // discord and fluxer have no profile url, so copy the handle instead
  document.querySelectorAll("[data-copy]").forEach(function (btn) {
    var label = btn.textContent;
    var timer;
    btn.addEventListener("click", function () {
      var value = btn.getAttribute("data-copy");
      if (!value || !navigator.clipboard) return;
      navigator.clipboard.writeText(value).then(
        function () {
          clearTimeout(timer);
          btn.textContent = "Copied!";
          timer = setTimeout(function () {
            btn.textContent = label;
          }, 1200);
        },
        function () {},
      );
    });
  });
</script>
