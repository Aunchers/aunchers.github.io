---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((proj) => ({
    params: { project: proj.data.name.toLowerCase() },
    props: { proj },
  }));
}

const { proj } = Astro.props;
const { Content } = await render(proj);
---

<BaseLayout title={`${proj.data.name} - Chairs`} description={proj.data.description} ogType="website">
  <nav class="sub-nav">
    <a href="/">home</a> /
    <a href="/projects">projects</a>
  </nav>

  <h1>{proj.data.name}</h1>
  <p class="muted"><em>{proj.data.description}</em></p>
  {proj.data.dateRange && <p class="muted">{proj.data.dateRange}</p>}

  {(proj.data.repo || proj.data.url) && (
    <p>
      {proj.data.repo && <a href={proj.data.repo} target="_blank" rel="noopener">source</a>}
      {proj.data.repo && proj.data.url && <span> · </span>}
      {proj.data.url && <a href={proj.data.url} target="_blank" rel="noopener">site</a>}
    </p>
  )}

  <hr>

  <article>
    <Content />
  </article>

  <hr>
  <p><a href="/projects">← back to all projects</a></p>
</BaseLayout>
