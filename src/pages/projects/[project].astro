---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { projectStatusLabels } from '@/project-status';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((proj) => ({
    params: { project: proj.data.name.toLowerCase() },
    props: { proj },
  }));
}

const { proj } = Astro.props;
const { Content } = await render(proj);

const status = projectStatusLabels[proj.data.status || 'active'];
---

<BaseLayout
  title={`${proj.data.name} - aunchers`}
  description={proj.data.description}
  section="projects"
>
  <header class="proj-hero">
    <h1 class="page-title">{proj.data.name}</h1>
    <p class="proj-hero-desc">{proj.data.description}</p>

    <div class="proj-hero-meta">
      {proj.data.dateRange && <span class="meta-date">{proj.data.dateRange}</span>}
      <span class="status-chip" data-status={proj.data.status || 'active'}>
        {status}
      </span>
    </div>

    {proj.data.tech && proj.data.tech.length > 0 && (
      <ul class="proj-taglist" style="margin-bottom: 0.9rem;">
        {proj.data.tech.map((t) => <li class="proj-tech-tag">{t}</li>)}
      </ul>
    )}

    {(proj.data.repo || proj.data.url) && (
      <div class="proj-hero-links">
        {proj.data.repo && (
          <a href={proj.data.repo} target="_blank" rel="noopener">source</a>
        )}
        {proj.data.url && (
          <a href={proj.data.url} target="_blank" rel="noopener">site</a>
        )}
      </div>
    )}
  </header>

  <div class="proj-body">
    <Content />
  </div>

  <nav class="post-nav">
    <a href="/projects">← all projects</a>
  </nav>
</BaseLayout>
