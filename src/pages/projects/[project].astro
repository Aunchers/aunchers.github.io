---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((proj) => ({
    params: { project: proj.data.name.toLowerCase() },
    props: { proj },
  }));
}

const { proj } = Astro.props;
const { Content } = await render(proj);
---

<BaseLayout title={`${proj.data.name} - CHAIRS`} description={proj.data.description} ogType="website">
  <nav class="sub-nav">
    <a href="/">home</a>
    <span class="sub-nav-sep">/</span>
    <a href="/projects">projects</a>
    <span class="sub-nav-sep">/</span>
    <span>{proj.data.name.toLowerCase()}</span>
  </nav>

  <h1 class="page-title"><em>/</em>{proj.data.name.toLowerCase()}</h1>
  <p class="page-desc">{proj.data.description}</p>
  {proj.data.dateRange && <p class="proj-dates">{proj.data.dateRange}</p>}

  {(proj.data.repo || proj.data.url) && (
    <p class="proj-links-bottom">
      {proj.data.repo && <a href={proj.data.repo} target="_blank" rel="noopener">source</a>}
      {proj.data.repo && proj.data.url && <span> · </span>}
      {proj.data.url && <a href={proj.data.url} target="_blank" rel="noopener">site</a>}
    </p>
  )}

  <hr>

  <div class="proj-body">
    <Content />
  </div>

  <div class="post-nav">
    <a href="/projects">all projects</a>
  </div>
</BaseLayout>
