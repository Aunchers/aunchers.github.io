---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout title="Projects - Chairs" description="things I've built, broken, and occasionally fixed.">
  <nav class="sub-nav">
    <a href="/">home</a>
  </nav>

  <h1>Projects</h1>
  <p>things I've built, broken, and occasionally fixed.</p>

  <ul class="postlist">
    {projects.map((proj) => (
      <li>
        <a href={`/projects/${proj.data.name.toLowerCase()}`}>{proj.data.name}</a>
        {proj.data.dateRange && <span class="muted"> ( {proj.data.dateRange} )</span>} —
        {proj.data.description}
      </li>
    ))}
  </ul>

  <hr>
  <p class="muted">{projects.length} projects · <a href="https://github.com/aunchers" rel="noopener">github</a></p>
</BaseLayout>
