---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import { projectStatusLabels } from '@/project-status';

const projects = await getCollection("projects");
---

<BaseLayout
  title="projects - aunchers"
  description="things I've built, broken, and occasionally fixed."
  section="projects"
>
  <h1 class="page-title">projects</h1>
  <p class="page-desc">things I've built, broken, and occasionally fixed.</p>

  <div class="proj-grid">
    {
      projects.map((proj) => (
        <article class="proj-card">
          <div class="proj-card-top">
            <h2 class="proj-name">
              <a href={`/projects/${proj.data.name.toLowerCase()}`}>
                {proj.data.name}
              </a>
            </h2>
            <span class="proj-dates">{proj.data.dateRange || ""}</span>
          </div>
          <p class="proj-desc">{proj.data.description}</p>
          {proj.data.tech && proj.data.tech.length > 0 && (
            <ul class="proj-taglist">
              {proj.data.tech.map((t) => (
                <li class="proj-tech-tag">{t}</li>
              ))}
            </ul>
          )}
          <div class="proj-foot">
            <span class="status-chip" data-status={proj.data.status || "active"}>
              {projectStatusLabels[proj.data.status || "active"]}
            </span>
            <span class="proj-foot-links">
              {proj.data.repo && (
                <a href={proj.data.repo} target="_blank" rel="noopener">
                  source
                </a>
              )}
              {proj.data.url && (
                <a href={proj.data.url} target="_blank" rel="noopener">
                  site
                </a>
              )}
            </span>
          </div>
        </article>
      ))
    }
  </div>

  <span slot="footer-meta">
    <a href="https://github.com/aunchers" target="_blank" rel="noopener"
      >github</a
    >
  </span>
</BaseLayout>
