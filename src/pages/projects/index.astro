---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from "astro:content";
import { projectStatusLabels } from '@/project-status';

const projects = await getCollection("projects");
---

<BaseLayout title="Projects - CHAIRS" description="things I've built, broken, and occasionally fixed." ogType="website">
  <nav class="sub-nav">
    <span class="sub-nav-links">
      <a href="/">home</a>
      <span class="sub-nav-sep">/</span>
      <span>projects</span>
    </span>
<button id="theme-toggle" class="theme-toggle" type="button" aria-label="switch theme" title="switch theme">◐</button>
  </nav>
  <hr>

  <h1 class="page-title"><em>/</em>projects</h1>
  <p class="page-desc">things I've built, broken, and occasionally fixed.</p>
  <hr>

  {projects.map((proj) => (
    <div class="proj-card">
      <div class="proj-card-top">
        <span class="proj-name"><a href={`/projects/${proj.data.name.toLowerCase()}`}>{proj.data.name}</a></span>
        <span class="proj-dates">{proj.data.dateRange || ''}</span>
      </div>
      <p class="proj-desc">{proj.data.description}</p>
      {proj.data.tech && proj.data.tech.length > 0 && (
        <ul class="proj-taglist">
          {proj.data.tech.map(t => <li class="proj-tech-tag">{t}</li>)}
        </ul>
      )}
      <div class="proj-foot">
        <span class="status-chip" data-status={proj.data.status || 'active'}>{projectStatusLabels[proj.data.status || 'active']}</span>
        <span class="proj-foot-links">
          {proj.data.repo && <a href={proj.data.repo} target="_blank" rel="noopener">source ↗</a>}
          {proj.data.url && <a href={proj.data.url} target="_blank" rel="noopener">site ↗</a>}
        </span>
      </div>
    </div>
  ))}

  <hr>
  <div class="flex-between" style="font-size:13px;">
    <span class="muted-text">{projects.length} projects</span>
    <a href="https://github.com/aunchers">github</a>
  </div>
</BaseLayout>
