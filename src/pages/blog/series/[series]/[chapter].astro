---
import SeriesPostList from '@/components/SeriesPostList.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesChapters, seriesInfo, seriesSlugs } from '@/lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return seriesSlugs.flatMap((series) =>
    seriesChapters(posts, series)
      .filter((chapter) => chapter.slug)
      .map((chapter) => ({
        params: { series, chapter: chapter.slug },
        props: { current: chapter },
      })),
  );
}

const { series } = Astro.params;
const info = seriesInfo[series!];
const { current } = Astro.props;
---

<BaseLayout
  title={`${current.name} - ${info.name} - aunchers`}
  description={`${current.name}, part of my ${info.name} series.`}
  ogType="article"
  section="blog"
>
  <h1 class="page-title">{current.name}</h1>
  <p class="page-desc">part of my {info.name} series.</p>

  {
    current.topics.length > 0 && (
      <ul class="series-list">
        {current.topics.map((topic) => (
          <li class="series-item">
            <a
              class="series-link"
              href={`/blog/series/${series}/${current.slug}/${topic.slug}`}
            >
              <span class="series-title">{topic.name}</span>
              <span class="series-count">· {topic.rows.length}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <SeriesPostList rows={current.loose} />

  <nav class="post-nav post-nav-flat">
    <a href={`/blog/series/${series}`}>← {info.name}</a>
  </nav>
</BaseLayout>
