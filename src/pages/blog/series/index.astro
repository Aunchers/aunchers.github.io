---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesInfo, seriesPosts } from '@/lib/series';

const posts = await getCollection('posts');
const groups = Object.entries(seriesInfo)
  .map(([slug, info]) => ({ slug, info, parts: seriesPosts(posts, slug) }))
  .filter((g) => g.parts.length > 0);
---

<BaseLayout title="series - aunchers" description="" section="blog">
  <h1 class="page-title">series</h1>
  <p class="page-desc">things in multiple parts.</p>

  {
    groups.length === 0 ? (
      <p class="empty-note">nothing in a series right now.</p>
    ) : (
      <ul class="series-list">
        {groups.map((g) => (
          <li class="series-item">
            <a class="series-link" href={`/blog/series/${g.slug}`}>
              <span class="series-title">{g.info.name}</span>
              <span class="series-count">- {g.parts.length}</span>
            </a>
            <p class="series-preview">{g.info.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
