---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesInfo, seriesPosts, seriesSlugs } from '@/lib/series';

export function getStaticPaths() {
  return seriesSlugs.map((slug) => ({ params: { series: slug } }));
}

const { series } = Astro.params;
const info = seriesInfo[series!];
const posts = await getCollection('posts');
const parts = seriesPosts(posts, series!);
const rows = parts.map((post, i) => ({ post, num: post.data.part ?? i + 1 }));
---

<BaseLayout
  title={`${info.name} - aunchers`}
  description={info.description}
  ogType="article"
  section="blog"
>
  <h1 class="page-title">{info.name}</h1>
  <p class="page-desc">{info.description}</p>

  <ul class="part-list">
    {
      rows.map((row) => (
        <li class="part-item">
          <a class="part-link" href={`/blog/${row.post.data.slug}`}>
            <span class="part-num">{String(row.num).padStart(2, '0')}</span>
            <span class="part-title">{row.post.data.title}</span>
          </a>
          <p class="part-preview">{row.post.data.description}</p>
        </li>
      ))
    }
  </ul>

  <nav class="post-nav post-nav-flat">
    <a href="/blog/series">← all series</a>
  </nav>
</BaseLayout>
