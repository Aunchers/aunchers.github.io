---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { seriesChapters, seriesInfo, seriesSlugs } from '@/lib/series';

export function getStaticPaths() {
  return seriesSlugs.map((slug) => ({ params: { series: slug } }));
}

const { series } = Astro.params;
const info = seriesInfo[series!];
const posts = await getCollection('posts');
const chapters = seriesChapters(posts, series!);
const groups = chapters.filter((chapter) => chapter.slug);
const loose = chapters.find((chapter) => chapter.slug === '')?.rows ?? [];
const total = chapters.reduce((n, chapter) => n + chapter.rows.length, 0);
---

<BaseLayout
  title={`${info.name} - aunchers`}
  description={info.description}
  ogType="article"
  section="blog"
>
  <h1 class="page-title">{info.name}</h1>
  <p class="page-desc">{info.description}</p>

  {
    total === 0 ? (
      <p class="empty-note">nothing here yet.</p>
    ) : (
      <>
        {groups.length > 0 && (
          <ul class="series-list">
            {groups.map((chapter) => (
              <li class="series-item">
                <a
                  class="series-link"
                  href={`/blog/series/${series}/${chapter.slug}`}
                >
                  <span class="series-title">{chapter.name}</span>
                  <span class="series-count">· {chapter.rows.length}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {loose.length > 0 && (
          <ul class="part-list">
            {loose.map((row) => (
              <li class="part-item">
                <a class="part-link" href={`/blog/${row.post.data.slug}`}>
                  <span class="part-title">{row.post.data.title}</span>
                </a>
                <p class="part-preview">{row.post.data.description}</p>
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }

  <nav class="post-nav post-nav-flat">
    <a href="/blog/series">← all series</a>
  </nav>
</BaseLayout>
