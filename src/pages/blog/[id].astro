---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import MathStyles from '@/components/MathStyles.astro';
import { postLastUpdated } from '@/lib/git-latest';
import { placeInSeries } from '@/lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => post.data.status !== 'draft')
    .map((post) => ({
      params: { id: post.data.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const lastCommit = postLastUpdated(post.data.slug);

const allPosts = await getCollection('posts');
const series = placeInSeries(allPosts, post);
---

<BlogPostLayout
  frontmatter={post.data}
  lastCommit={lastCommit}
  headings={headings}
  series={series}
>
  <MathStyles />
  <Content />
</BlogPostLayout>
