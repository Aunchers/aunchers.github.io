---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '@/layouts/BlogPostLayout.astro';
import { postLastUpdated } from '@/lib/git-latest';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => post.data.status !== 'draft')
    .map((post) => ({
      params: { id: post.data.slug },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lastCommit = postLastUpdated(post.data.slug);
---

<BlogPostLayout frontmatter={post.data} lastCommit={lastCommit}>
  {post.data.accessPassword ? (
    <div class="private-post" data-password={post.data.accessPassword}>
      <div class="private-post-gate">
        <p>checking access...</p>
      </div>
      <div class="private-post-content" hidden>
        <Content />
      </div>
    </div>
  ) : (
    <Content />
  )}
</BlogPostLayout>

{post.data.accessPassword && (
  <script>
    const post = document.querySelector('.private-post');
    const gate = post?.querySelector('.private-post-gate');
    const content = post?.querySelector('.private-post-content');
    const queryPassword = new URLSearchParams(location.search).get('pwd');
    if (queryPassword !== post.dataset.password) {
      location.replace('/404');
    } else {
      localStorage.setItem(`post-access:${location.pathname.split('/').pop()}`, 'granted');
      gate.hidden = true;
      content.hidden = false;
    }
  </script>
)}
