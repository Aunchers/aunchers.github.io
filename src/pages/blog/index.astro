---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const visiblePosts = allPosts.filter(p => p.data.status !== "draft");
visiblePosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const postsByYear = visiblePosts.reduce((acc, post) => {
  const year = post.data.date.getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});
const sortedYears = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

const fmt = (d) => {
  const date = new Date(d);
  return String(date.getDate()).padStart(2, "0") + "/" + String(date.getMonth() + 1).padStart(2, "0") + "/" + date.getFullYear();
};

---

<BaseLayout
  title="Blog - CHAIRS"
  description="thoughts, tutorials, logs, and other writings."
  ogType="article"
>
  <nav class="sub-nav">
    <span class="sub-nav-links">
      <a href="/">home</a>
      <span class="sub-nav-sep">/</span>
      <span>blog</span>
    </span>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="switch theme"
      title="switch theme">◐</button
    >
  </nav>
  <hr />

  <h1 class="page-title"><em>/</em>blog</h1>
  <p class="page-desc">thoughts, tutorials, logs, and other writings.</p>
  <hr />

  {
    visiblePosts.length === 0 ? (
      <p>no posts right now. they'll show up here when there are some.</p>
    ) : (
      <ul class="post-list">
        {visiblePosts.map((post) => (
          <li class="post-item">
            <div class="post-header">
              <time
                class="post-date-inline"
                datetime={post.data.date.toISOString()}
              >
                {fmt(post.data.date)}
              </time>
              <div class="post-title-text">
                <a
                  href={`/blog/${post.data.slug}`}
                  class:list={[{ archived: post.data.status === "archived" }]}
                >
                  {post.data.title}
                </a>
              </div>
            </div>
            {post.data.description && (
              <p class="post-preview">{post.data.description}</p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <span slot="footer-meta" class="muted-text">
    {visiblePosts.length} posts · <span class="footnote-ref"
      ><a href="/rss.xml">rss</a></span
    >
    {" · "}
  </span>
</BaseLayout>
