---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const listedPosts = allPosts
  .filter((p) => p.data.status !== 'draft')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const postsByYear = listedPosts.reduce(
  (acc, post) => {
    const year = post.data.date.getFullYear();
    (acc[year] ||= []).push(post);
    return acc;
  },
  {} as Record<number, typeof listedPosts>,
);
const sortedYears = Object.keys(postsByYear).sort(
  (a, b) => Number(b) - Number(a),
);

const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title="blog - aunchers"
  description="ramblings of a canadian guy who likes computers."
  ogType="article"
  section="blog"
>
  <h1 class="page-title">blog</h1>
  <p class="page-desc">thoughts, tutorials, journalism, and other writings.</p>

  {
    listedPosts.length === 0 ? (
      <p class="empty-note">
        no posts right now. they'll show up here when there are some.
      </p>
    ) : (
      sortedYears.map((year) => (
        <section class="year-block">
          <h2 class="year-label">{year}</h2>
          <ul class="post-list">
            {postsByYear[Number(year)].map((post) => (
              <li class="post-item">
                <a
                  class="post-link"
                  class:list={{ archived: post.data.status === "archived" }}
                  href={`/blog/${post.data.slug}`}
                >
                  <time
                    class="post-date"
                    datetime={post.data.date.toISOString()}
                  >
                    {iso(post.data.date)}
                  </time>
                  <span class="post-title">{post.data.title}</span>
                </a>
                {post.data.description && (
                  <p class="post-preview">{post.data.description}</p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
